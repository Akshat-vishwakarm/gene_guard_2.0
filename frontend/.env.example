# GeneGuard Frontend Environment Variables (Vercel & Local)
# ========================================================

# The Render service URL where the Flask backend is hosted.
# In Vercel Project Settings -> Environment Variables, set:
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
#
# For local development, leave unset (defaults to http://localhost:5000/api)
# or specify explicitly:
VITE_API_URL="http://localhost:5000"

# Optional: Dedicated standalone chatbot URL (if running separate chatbot service)
# If left empty, chatbot calls route to ${VITE_API_URL}/api/chat automatically.
VITE_CHATBOT_URL=""

# GeneGuard Backend Environment Variables (Render & Local)
# ========================================================

# Port for local development (Render sets PORT automatically)
PORT=5000

# Vercel Frontend Domain for CORS
# In Render Dashboard -> Environment Variables:
# FRONTEND_URL=https://your-geneguard-frontend.vercel.app
# Multiple origins can be comma-separated.
FRONTEND_URL="http://localhost:5173"

# Google Gemini API Key for clinical evaluation and RAG synthesis
# In Render Dashboard -> Environment Variables:
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=""

# Gemini model identifier (default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"
